<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppGrabarAudio.MainPage"
             BackgroundColor="#FFFFFF">

    <VerticalStackLayout
        Padding="0"
        Spacing="0"
        VerticalOptions="FillAndExpand">
        
        <VerticalStackLayout
            Padding="30"
            Spacing="40"
            VerticalOptions="CenterAndExpand"
            HorizontalOptions="CenterAndExpand">
            
            <Label
                Text="Grabadora de Audio"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#000000"
                HorizontalOptions="Center" />
            
            <Button
                Text="Grabar"
                x:Name="BtnIniciarGrabacion"
                Clicked="BtnIniciarGrabacion_Clicked"
                Padding="40,20"
                FontSize="18"
                BackgroundColor="#007AFF"
                TextColor="#FFFFFF"
                CornerRadius="12" />
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentPage>
