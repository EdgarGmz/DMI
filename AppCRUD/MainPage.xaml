<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppCRUD.MainPage">
 
    <!-- Contenido de la aplicacación -->
    <StackLayout>
        <Border
            Padding="24"
            BackgroundColor="Blue"
            StrokeShape="RoundRectangle 5">

            <Label
                Text="Registro de Empleados"
                HorizontalTextAlignment="Center"
                TextColor="White"
                FontSize="36"/>
        </Border>
        
     <!-- Datos de entrada -->   
        <Entry
            x:Name="txtIdEmp"
            IsEnabled="False"/>
        
        <Entry
            Placeholder="Nombre del empleado"
            x:Name="txtEmpleado"
            />

        <Entry
            Placeholder="Apellido Paterno"
            x:Name="txtApPaterno"/>

        <Entry
            Placeholder="Apellido Materno"
            x:Name="txtApMaterno"/>

        <Entry
            Placeholder="Edad"
            x:Name="txtEdad"/>

        <Entry
            Placeholder="Telefono"
            x:Name="txtTelefono"/>
        
        <!-- Botones de acción -->
        <Button
            Text="Guardar"
            x:Name="btnGuardar"
            Clicked="btnGuardar_Clicked"/>

        <Button
            Text="Actualizar"
            x:Name="btnActualizar"
            Clicked="btnActualizar_Clicked"/>

        <Button
            Text="Eliminar"
            x:Name="btnEliminar"
            Clicked="btnEliminar_Clicked"/>
        
        <!-- Listado de Información -->
        <ListView
            x:Name="lsEmpleados"
            ItemSelected="lsEmpleados_ItemSelected">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label 
                                Text="{Binding IdEmp}"
                                Grid.Row="0"
                                Grid.Column="0"
                                TextColor="Blue"/>

                            <Label 
                                Text="{Binding Nombre}"
                                Grid.Row="0"
                                Grid.Column="1"
                                TextColor="Gray"/>

                            <Label 
                                Text="{Binding ApellidoPaterno}"
                                Grid.Row="0"
                                Grid.Column="2"
                                TextColor="Gray"/>

                            <Label 
                                Text="{Binding ApellidoMaterno}"
                                Grid.Row="0"
                                Grid.Column="3"
                                TextColor="Gray"/>

                            <Label 
                                Text="{Binding Edad}"
                                Grid.Row="0"
                                Grid.Column="4"
                                TextColor="Orange"/>

                            <Label 
                                Text="{Binding Telefono}"
                                Grid.Row="1"
                                Grid.Column="1"
                                TextColor="Green"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>

</ContentPage>
