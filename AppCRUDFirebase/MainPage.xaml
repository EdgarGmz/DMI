<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppCRUDFirebase.MainPage">

    <StackLayout
        Padding="20">

        <Label
            Text="Menú Principal"
            FontSize="24"
            HorizontalOptions="Center"/>

        <Button
            Text="Agregar Producto"
            x:Name="btnAgregarP"
            Clicked="btnAgregarP_Clicked"/>

        <Button
            Text="Buscar Producto"
            x:Name="btnBuscarP"
            Clicked="btnBuscarP_Clicked"/>

        <Button
            Text="Listar Producto"
            x:Name="btnListarP"
            Clicked="btnListarP_Clicked"/>

    </StackLayout>

</ContentPage>
